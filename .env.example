# NVIDIA API key for Llama 3.2 90B Vision (image forensics)
# Get yours at https://build.nvidia.com
NV_API_KEY="your-nvidia-api-key-here"

# NVIDIA API config (optional)
NV_BASE_URL="https://integrate.api.nvidia.com/v1"
NV_MODEL="meta/llama-3.2-90b-vision-instruct"

# HuggingFace API key for Aya Vision 32B
# Get yours at https://huggingface.co/settings/tokens
hugging_face_api="your-huggingface-api-key-here"

# App URL
APP_URL="http://localhost:3000"
